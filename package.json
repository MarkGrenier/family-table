{
  "name": "family-grocery",
  "private": true,
  "version": "1.0.0",
  "description": "A shared grocery list for Mark and Emma.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "setup": "node scripts/setup.mjs",
    "seed": "wrangler d1 execute grocery --local --yes --file=./seed.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261018.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
